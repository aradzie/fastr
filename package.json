{
  "name": "@fastr/root",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/aradzie/fastr#readme",
  "repository": "aradzie/fastr",
  "license": "MIT",
  "author": "Aliaksandr Radzivanovich <aradzivanovich@gmail.com>",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "clean": "turbo run clean",
    "compile": "turbo run compile",
    "format": "prettier '{**/*,*}.{js,ts}' --write",
    "lint": "eslint '{**/*,*}.{js,ts}'",
    "lint-fix": "eslint '{**/*,*}.{js,ts}' --fix",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.2",
    "ava": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "mockdate": "^3.0.5",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
